# Salin file ini ke .env dan isi nilai sebenarnya. .env TIDAK di-commit ke git.

# Database (dev = SQLite, zero-setup. Prod = ganti provider di prisma/schema.prisma ke postgresql + DATABASE_URL Postgres)
DATABASE_URL="file:./dev.db"

# Auth.js (NextAuth) — generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="ganti-dengan-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI — dipakai untuk AI Mobilization (FR-09/FR-10) & AI Chat (FR-30/FR-31)
# Kalau kuota habis, tinggal ganti nilai ini, tidak ada key ter-hardcode di kode.
OPENAI_API_KEY="sk-..."

# NFR-04: kunci enkripsi at-rest field sensitif (NIK). 32 byte hex — generate dengan:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="ganti-dengan-64-karakter-hex-acak"
